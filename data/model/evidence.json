{
  "_comment": "Hand written. What proves each wire constant and what explains each finding of the mapping inference; checked by `./gradlew :tools:checkMappings` and UpdateTest against the spec captures (see tools/docs/codegen.md, 'Evidence').",
  "findings": {
    "residual-bits block:minecraft:material_instances packed_bools": {
      "status": "unexplained",
      "reason": "bit 2 of packed_bools is set in every material BDS sent (values 4, 5, 7); face_dimming is bit 0 and isotropic bit 1, no field moves bit 2. Unverified hypothesis (wiki.bedrock.dev block format history, not BDS): bit 2 is texture variation / alpha_masked_tint support, switched on by the format version",
      "wouldExplain": "the planned format_version sweep of the spec capture (the same add-on generated at several format versions, run on BDS) and an alpha_masked_tint probe (a variant with a non-none tint_method and format_version >= 1.21.120)"
    }
  },
  "constants": {
    "Transforms always_set_bit": {
      "status": "unexplained",
      "reason": "meaning of bit 2 of packed_bools unknown (see the finding for material_instances packed_bools)",
      "wouldExplain": "the planned format_version sweep of the spec capture (the same add-on generated at several format versions, run on BDS)"
    },
    "Transforms alpha_masked_tint": {
      "status": "unexplained",
      "reason": "embedded_visual's alpha_masked_tint flag was never seen on the wire: BDS rejected every embedded_visual variant that carries material_instances",
      "wouldExplain": "an accepted embedded_visual variant with material_instances (a companion aware control) and the alpha_masked_tint probe"
    },
    "Transforms descriptor_state_type": {
      "status": "unexplained",
      "reason": "the type id of a block descriptor state was seen as int 2 only; string 1 and boolean 0 follow the same order but were never captured",
      "wouldExplain": "block descriptor variants with a string and a boolean state of a known block"
    },
    "Transforms hover_text_color_codes": {
      "status": "unexplained",
      "reason": "only the color names of the accepted hover_text_color variants were captured; the formatting code of the others comes from Bedrock's color table, not from BDS",
      "wouldExplain": "one hover_text_color variant per color name"
    },
    "Transforms face_bit_order": {
      "status": "unexplained",
      "reason": "every variant with a face list was rejected by BDS; the bit order comes from vanilla data (liquid detection), not from an accepted add-on variant",
      "wouldExplain": "a face list BDS accepts (companion aware control)"
    },
    "Transforms use_animation_ids": {
      "status": "unexplained",
      "reason": "only eat (1) and spear (6) were captured; the other animation ids are taken from vanilla items",
      "wouldExplain": "one use_animation variant per animation name"
    },
